{
    "name": "designkarma/craft-analytics",
    "description": "A simple Google Analytics 4 dashboard widget for Craft CMS.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "craftcms",
        "analytics",
        "google analytics",
        "ga4"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "DesignKarma",
            "homepage": "https://designkarma.co.uk"
        }
    ],
    "support": {
        "issues": "https://github.com/designkarma/craft-analytics/issues",
        "source": "https://github.com/designkarma/craft-analytics",
        "docs": "https://github.com/designkarma/craft-analytics/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0",
        "google/analytics-data": "^0.26.1"
    },
    "autoload": {
        "psr-4": {
            "designkarma\\analytics\\": "src/"
        }
    },
    "extra": {
        "name": "Google Analytics",
        "handle": "google-analytics",
        "class": "designkarma\\analytics\\Plugin",
        "developer": "DesignKarma",
        "developerUrl": "https://designkarma.co.uk"
    }
}