<div class="analytics-widget">

    <div class="analytics-widget__header">
        <strong>Performance</strong>
        <span class="analytics-widget__period">
            Last {{ days }} days
        </span>
    </div>

    <div class="analytics-metrics">

        <div class="analytics-metric">
            <div class="analytics-metric__label">Users</div>
            <div class="analytics-metric__value">
                {{ users|number_format }}
            </div>
            <div class="analytics-metric__change analytics-metric__change--up">
                {% set change = changes.users %}
				{% if change is null %}
				    <div class="analytics-metric__change">
				        No previous data
				    </div>
				{% elseif change > 0 %}
				    <div class="analytics-metric__change analytics-metric__change--up">
				        ↑ {{ change|abs|number_format(1) }}%
				    </div>
				{% elseif change < 0 %}
				    <div class="analytics-metric__change analytics-metric__change--down">
				        ↓ {{ change|abs|number_format(1) }}%
				    </div>
				{% else %}
				    <div class="analytics-metric__change">
				        – 0.0%
				    </div>
				{% endif %}
            </div>
        </div>

        <div class="analytics-metric">
            <div class="analytics-metric__label">Sessions</div>
            <div class="analytics-metric__value">
                {{ sessions|number_format }}
            </div>
            <div class="analytics-metric__change analytics-metric__change--up">
                {% set change = changes.sessions %}
                {% if change is null %}
				    <div class="analytics-metric__change">
				        No previous data
				    </div>
				{% elseif change > 0 %}
				    <div class="analytics-metric__change analytics-metric__change--up">
				        ↑ {{ change|abs|number_format(1) }}%
				    </div>
				{% elseif change < 0 %}
				    <div class="analytics-metric__change analytics-metric__change--down">
				        ↓ {{ change|abs|number_format(1) }}%
				    </div>
				{% else %}
				    <div class="analytics-metric__change">
				        – 0.0%
				    </div>
				{% endif %}
            </div>
        </div>

        <div class="analytics-metric">
            <div class="analytics-metric__label">Page views</div>
            <div class="analytics-metric__value">
                {{ pageViews|number_format }}
            </div>
            <div class="analytics-metric__change analytics-metric__change--down">
                {% set change = changes.pageViews %}
                {% if change is null %}
				    <div class="analytics-metric__change">
				        No previous data
				    </div>
				{% elseif change > 0 %}
				    <div class="analytics-metric__change analytics-metric__change--up">
				        ↑ {{ change|abs|number_format(1) }}%
				    </div>
				{% elseif change < 0 %}
				    <div class="analytics-metric__change analytics-metric__change--down">
				        ↓ {{ change|abs|number_format(1) }}%
				    </div>
				{% else %}
				    <div class="analytics-metric__change">
				        – 0.0%
				    </div>
				{% endif %}
            </div>
        </div>

    </div>

    <div class="analytics-widget__section">

        <div class="analytics-widget__chart-header">
            <h3 class="analytics-widget__section-title">
                Page views
            </h3>

            <span class="analytics-widget__chart-total">
                {{ pageViews|number_format }} total
            </span>
        </div>

        {% if dailyViews|length > 1 %}
            {% set chartWidth = 600 %}
            {% set chartHeight = 140 %}
            {% set chartPadding = 4 %}
            {% set maxViews = max(dailyViews) %}
            {% set minViews = min(dailyViews) %}
            {% set range = maxViews - minViews %}
            {% set points = [] %}

            {% for views in dailyViews %}
                {% set x = loop.index0 / (dailyViews|length - 1) * chartWidth %}

                {% if range > 0 %}
                    {% set y = chartPadding
                        + ((maxViews - views) / range)
                        * (chartHeight - (chartPadding * 2))
                    %}
                {% else %}
                    {% set y = chartHeight / 2 %}
                {% endif %}

                {% set points = points|merge([x ~ ',' ~ y]) %}
            {% endfor %}

            <div class="analytics-chart">
                <svg
                    viewBox="0 0 {{ chartWidth }} {{ chartHeight }}"
                    preserveAspectRatio="none"
                    role="img"
                    aria-label="Page views trend over the last {{ days }} days"
                >
                    <polyline
                        class="analytics-chart__line"
                        points="{{ points|join(' ') }}"
                    />
                </svg>
            </div>
        {% elseif dailyViews|length == 1 %}
            <p class="light">
                Not enough data to display a trend yet.
            </p>
        {% else %}
            <p class="light">
                No page view data available for this period.
            </p>
        {% endif %}

    </div>

    <div class="analytics-widget__section">

        <h3 class="analytics-widget__section-title">
            Top pages
        </h3>

        <table class="data fullwidth analytics-widget__table">
            <thead>
                <tr>
                    <th>Page</th>
                    <th>Views</th>
                </tr>
            </thead>

            <tbody>
                {% for page in topPages %}
                    <tr>
                        <td>{{ page.title }}</td>
                        <td>{{ page.views|number_format }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    </div>

    <div class="analytics-widget__section">
        <h3 class="analytics-widget__section-title">
            Traffic Sources
        </h3>

        {% if trafficSources %}
            <table class="data fullwidth analytics-widget__table">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Sessions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for source in trafficSources %}
                        <tr>
                            <td>{{ source.source }}</td>
                            <td>{{ source.sessions|number_format }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="light">No traffic source data available.</p>
        {% endif %}
    </div>

</div>