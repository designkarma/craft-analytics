<div class="analytics-widget">

    <div class="analytics-widget__header">
        <h2>Performance</h2>

        <div class="analytics-widget__period">
            Last {{ days }} days
        </div>
    </div>

    <div class="analytics-metrics">

        {% set metrics = [
            {
                label: 'Users',
                value: users,
                change: changes.users
            },
            {
                label: 'Sessions',
                value: sessions,
                change: changes.sessions
            },
            {
                label: 'Page views',
                value: pageViews,
                change: changes.pageViews
            }
        ] %}

        {% for metric in metrics %}
            <div class="analytics-metric">
                <div class="analytics-metric__label">
                    {{ metric.label }}
                </div>

                <div class="analytics-metric__value">
                    {{ metric.value|number_format }}
                </div>

                {% if metric.change is null %}
                    <div class="analytics-metric__change">
                        No previous data
                    </div>
                {% elseif metric.change > 0 %}
                    <div class="analytics-metric__change analytics-metric__change--up">
                        ↑ {{ metric.change|abs|number_format(1) }}%
                    </div>
                {% elseif metric.change < 0 %}
                    <div class="analytics-metric__change analytics-metric__change--down">
                        ↓ {{ metric.change|abs|number_format(1) }}%
                    </div>
                {% else %}
                    <div class="analytics-metric__change">
                        – 0.0%
                    </div>
                {% endif %}
            </div>
        {% endfor %}

    </div>

    <div class="analytics-widget__section">

        <div class="analytics-widget__chart-header">
            <h3 class="analytics-widget__section-title">
                Page Views
            </h3>

            <div class="analytics-widget__chart-total">
                Last {{ days }} days
            </div>
        </div>

        {% if dailyViews|length > 1 %}

            {% set chartWidth = 600 %}
            {% set chartHeight = 160 %}
            {% set plotTop = 10 %}
            {% set plotBottom = 130 %}
            {% set plotHeight = plotBottom - plotTop %}

            {% set values = dailyViews|map(item => item.views) %}
            {% set maxViews = max(values) %}
            {% set minViews = min(values) %}
            {% set range = maxViews - minViews %}
            {% set points = [] %}

            {% for item in dailyViews %}

                {% set x =
                    loop.index0
                    / (dailyViews|length - 1)
                    * chartWidth
                %}

                {% if range > 0 %}
                    {% set y =
                        plotTop
                        + ((maxViews - item.views) / range)
                        * plotHeight
                    %}
                {% else %}
                    {% set y = plotTop + (plotHeight / 2) %}
                {% endif %}

                {% set points = points|merge([
                    x ~ ',' ~ y
                ]) %}

            {% endfor %}

            <div class="analytics-chart">

                <svg
                    viewBox="0 0 {{ chartWidth }} {{ chartHeight }}"
                    preserveAspectRatio="none"
                    role="img"
                    aria-label="Page views trend over the last {{ days }} days"
                >

                    <defs>
                        <linearGradient
                            id="analytics-chart-gradient"
                            x1="0"
                            y1="0"
                            x2="0"
                            y2="1"
                        >
                            <stop
                                offset="0%"
                                stop-color="#3b82f6"
                                stop-opacity="0.25"
                            />
                            <stop
                                offset="100%"
                                stop-color="#3b82f6"
                                stop-opacity="0"
                            />
                        </linearGradient>
                    </defs>

                    {% for position in [0, 0.5, 1] %}
                        {% set y = plotTop + (plotHeight * position) %}

                        <line
                            class="analytics-chart__grid"
                            x1="0"
                            y1="{{ y }}"
                            x2="{{ chartWidth }}"
                            y2="{{ y }}"
                        />
                    {% endfor %}

                    <polygon
                        class="analytics-chart__area"
                        points="
                            0,{{ plotBottom }}
                            {{ points|join(' ') }}
                            {{ chartWidth }},{{ plotBottom }}
                        "
                    />

                    <polyline
                        class="analytics-chart__line"
                        points="{{ points|join(' ') }}"
                    />
                </svg>

                <div class="analytics-chart__markers">
                    {% for item in dailyViews %}

                        {% set xPercent =
                            loop.index0
                            / (dailyViews|length - 1)
                            * 100
                        %}

                        {% if range > 0 %}
                            {% set y =
                                plotTop
                                + ((maxViews - item.views) / range)
                                * plotHeight
                            %}
                        {% else %}
                            {% set y = plotTop + (plotHeight / 2) %}
                        {% endif %}

                        {% set yPercent = y / chartHeight * 100 %}

                        <button
                            type="button"
                            class="analytics-chart__marker"
                            style="left: {{ xPercent }}%; top: {{ yPercent }}%;"
                            data-analytics-chart-point
                            data-label="{{ item.label }}"
                            data-views="{{ item.views }}"
                            aria-label="{{ item.label }}: {{ item.views }} page views"
                        >
                            <span></span>
                        </button>

                    {% endfor %}
                </div>

                <div
                    class="analytics-chart__tooltip"
                    data-analytics-chart-tooltip
                    hidden
                >
                    <strong data-analytics-chart-tooltip-label></strong>
                    <span data-analytics-chart-tooltip-value></span>
                </div>

                <div class="analytics-chart__labels">
                    <span>{{ dailyViews|first.label }}</span>

                    <span>
                        {{ dailyViews[(dailyViews|length / 2)|round(0, 'floor')].label }}
                    </span>

                    <span>{{ dailyViews|last.label }}</span>
                </div>

            </div>

        {% elseif dailyViews|length == 1 %}

            <p class="light">
                Not enough data to display a trend yet.
            </p>

        {% else %}

            <p class="light">
                No page view data available for this period.
            </p>

        {% endif %}

    </div>

    <div class="analytics-widget__section">

        <h3 class="analytics-widget__section-title">
            Top Pages
        </h3>

        {% if topPages %}
            <table class="data fullwidth analytics-widget__table">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th>Views</th>
                    </tr>
                </thead>
                <tbody>
                    {% for page in topPages %}
                        <tr>
                            <td>
                                {% if page.path %}
                                    <a
                                        href="{{ siteUrl(page.path|trim('/')) }}"
                                        target="_blank"
                                        rel="noopener"
                                    >
                                        {{ page.title }}
                                    </a>
                                {% else %}
                                    {{ page.title }}
                                {% endif %}
                            </td>
                            <td>{{ page.views|number_format }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="light">
                No page data available for this period.
            </p>
        {% endif %}

    </div>

    <div class="analytics-widget__section">

        <h3 class="analytics-widget__section-title">
            Traffic Sources
        </h3>

        {% if trafficSources %}
            <table class="data fullwidth analytics-widget__table">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th>Sessions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for source in trafficSources %}
                        <tr>
                            <td>{{ source.source }}</td>
                            <td>{{ source.sessions|number_format }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="light">
                No traffic source data available for this period.
            </p>
        {% endif %}

    </div>

</div>